{
    "name": "sqe-scroll-editor",
    "version": "0.7.0",
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "check:all": "node scripts/check-bootstrap5-parity.js && node scripts/check-notification-coverage.js",
        "pretest-ci": "npm run check:all",
        "pretest": "npm run check:all",
        "test-ci": "cypress run",
        "test": "cypress open",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:unit:cov": "vitest run --coverage",
        "test:e2e": "playwright test --config playwright.config.mts",
        "test:e2e:ui": "playwright test --config playwright.config.mts --ui",
        "test:e2e:cov": "rm -rf .nyc_output && playwright test --config playwright.config.mts && nyc report --reporter=text-summary --reporter=html --temp-dir .nyc_output",
        "coverage:combined": "node scripts/coverage-combined.mjs",
        "check:notifications": "node scripts/check-notification-coverage.js",
        "check:bootstrap5": "node scripts/check-bootstrap5-parity.js"
    },
    "dependencies": {
        "@ckeditor/ckeditor5-build-classic": "^23.0.0",
        "@ckeditor/ckeditor5-vue": "^1.0.3",
        "@fortawesome/fontawesome-svg-core": "^1.2.36",
        "@fortawesome/free-brands-svg-icons": "^5.15.4",
        "@fortawesome/free-regular-svg-icons": "^5.15.4",
        "@fortawesome/free-solid-svg-icons": "^5.15.4",
        "@fortawesome/vue-fontawesome": "^3",
        "@microsoft/signalr": "^10",
        "@types/js-clipper": "^0.0.28",
        "@types/jsts": "^0.17.2",
        "@types/mathjs": "^4.4.5",
        "axios": "^1.13.0",
        "bootstrap": "^5",
        "bootstrap-vue-next": "^0.45.8",
        "core-js": "^3.13.0",
        "js-clipper": "^1.0.1",
        "jsts": "^2.1.0",
        "mathjs": "^15.2.0",
        "mitt": "^3.0.1",
        "pinia": "^4.0.2",
        "uuid": "^14.0.1",
        "vue": "^3",
        "vue-facing-decorator": "^4.0.1",
        "vue-i18n": "^9",
        "vue-lazyload": "^1.3.3",
        "vue-router": "^4",
        "vue-toasted": "^1.1.28",
        "vue-virtual-scroller": "^1.0.10",
        "wait-on": "^9.0.10",
        "y18n": "^4.0.3"
    },
    "resolutions": {
        "cross-spawn": "^7.0.6",
        "ansi-regex": "^5.0.1",
        "lodash": "^4.17.24",
        "js-yaml": "^4.3.0",
        "node-fetch": "^2.7.0",
        "qs": "^6.15.2",
        "bn.js": "^4.12.3"
    },
    "devDependencies": {
        "@babel/plugin-proposal-nullish-coalescing-operator": "^7.14.2",
        "@babel/plugin-proposal-optional-chaining": "^7.14.2",
        "@cypress/code-coverage": "^3",
        "@playwright/test": "^1.61.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/coverage-istanbul": "4",
        "@vitest/coverage-v8": "^4.1.10",
        "@vue/test-utils": "^2.4.11",
        "cross-env": "^7.0.3",
        "cypress": "14.5.4",
        "happy-dom": "^20.11.1",
        "mailslurp-client": "^12.0.0",
        "nyc": "^18.0.0",
        "sass": "^1.101.3",
        "typescript": "^5.9.3",
        "vite": "^8.1.5",
        "vite-plugin-istanbul": "^6",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.7"
    }
}
